# Copy to .env and fill in before `docker compose up`. This file is for the
# Backend/Dashboard/Postgres stack only — the Daemon is configured separately per node,
# see docs/deployment.md.

# Postgres password for the `easypanel` role/database this compose file creates.
POSTGRES_PASSWORD=

# Long random secret signing every JWT. Generate one with: openssl rand -base64 48
# Rotating this logs out every active session immediately.
JWT_SIGNING_KEY=

# Host ports this compose file publishes. Change if they collide with something else
# already running on the host. Point your reverse proxy (nginx/Caddy/Traefik/NetBird/
# your cloud LB) at DASHBOARD_PORT if you're exposing the panel beyond your own network —
# that's the only port a browser needs to reach. BACKEND_PORT only needs to be reachable
# by the Daemon (and by you directly, for debugging); the Dashboard itself talks to the
# backend over the internal Docker network, never through this port.
BACKEND_PORT=5299
DASHBOARD_PORT=3000
