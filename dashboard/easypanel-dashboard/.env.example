# Copy to .env.local and set the value below, then `npm run dev` / `npm run build`.
#
# EASYPANEL_BACKEND_URL is the only backend address this app needs. It is read
# server-side only — by Server Actions, Route Handlers, and the server-side SignalR
# connection that backs the live console/node Server-Sent-Events streams — and is never
# exposed to the browser, so it can be the backend's plain internal/LAN address and does
# not need to be public or behind TLS itself. See docs/deployment.md ("Deploying the
# Dashboard"). Defaults to http://localhost:5299 when unset (see src/lib/config.ts).
EASYPANEL_BACKEND_URL=http://localhost:5299
